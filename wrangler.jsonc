{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "proxychat",
  "main": "src/worker.js",
  "compatibility_date": "2026-03-25",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // A path that is no file reaches src/worker.js, which hands Zeiko Drive's
    // own paths (shared links among them) to Drive and answers the rest with
    // 404.html. With "404-page" here, a link opened in a browser would get
    // the 404 page before the worker could see it.
    "not_found_handling": "none",
    // Plain files that the worker fills in first: /models (the hourly
    // figures), /drive (Drive's plans) and /account (one page for every
    // account address).
    "run_worker_first": ["/models", "/drive", "/id/drive", "/account", "/account/*"]
  },
  // /account is one plain page (public/account/index.html) whose script signs
  // in with the account door itself: no secret is set for it here.
  // Read-only: the hourly model snapshot, rendered into /models.
  "r2_buckets": [
    { "binding": "MODELS", "bucket_name": "zeiko-models" }
  ],
  // Zeiko Drive's Worker serves /dashboard (and its /api, downloads and
  // shared links) here once it runs in production: add
  //   "services": [{ "binding": "DRIVE", "service": "zeiko-production" }]
  // after it is deployed (a binding to a Worker that does not exist yet
  // fails the deploy). Until then /dashboard sends visitors to /drive.
  // Drive's staging keeps its own address (staging.zeiko.biz.id), where it
  // serves /dashboard by itself.
}

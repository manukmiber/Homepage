{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "proxychat",
  "compatibility_date": "2026-03-25",
  // Static files only: every path is a file under ./public. No script,
  // no bindings. See CLAUDE.md before adding either.
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  }
}

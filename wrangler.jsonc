{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "proxychat",
  "main": "src/worker.js",
  "compatibility_date": "2026-03-25",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Only these reach src/worker.js; every other path is a static file.
    "run_worker_first": ["/data/*", "/models/*"]
  },
  // The relay uploads models.json here once an hour (see the relay's
  // `website` config). The site only ever reads it.
  "r2_buckets": [
    { "binding": "MODELS", "bucket_name": "zeiko-models" }
  ]
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "proxychat",
  "main": "src/worker.js",
  "compatibility_date": "2026-03-25",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Only /models and /account reach src/worker.js; every other path is a
    // plain file.
    "run_worker_first": ["/models", "/account", "/account/*"]
  },
  // /account is one plain page (public/account/index.html) whose script signs
  // in with the account door itself: no secret is set for it here.
  // Read-only: the hourly model snapshot, rendered into /models.
  "r2_buckets": [
    { "binding": "MODELS", "bucket_name": "zeiko-models" }
  ]
}

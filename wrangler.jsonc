{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "proxychat",
  "main": "src/worker.js",
  "compatibility_date": "2026-03-25",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // A path that is no file reaches src/worker.js, which sends /dashboard…
    // (Zeiko Drive's old address, still the way back to it) to
    // drive.zeiko.biz.id and answers the rest with 404.html. With "404-page"
    // here, a link opened in a browser would get the 404 page before the
    // worker could see it.
    "not_found_handling": "none",
    // Plain files that the worker fills in first: /models (the hourly
    // figures), /drive (Drive's plans), the homepage (Zeiko S3, once it is
    // open) and /account (one page for every account address).
    "run_worker_first": ["/", "/id", "/id/", "/models", "/id/models", "/drive", "/id/drive", "/account", "/account/*"]
  },
  // /account is one plain page (public/account/index.html) whose script signs
  // in with the account door itself: no secret is set for it here.
  // Read-only: the hourly model snapshot, rendered into /models.
  "r2_buckets": [
    { "binding": "MODELS", "bucket_name": "zeiko-models" }
  ],
  // Zeiko Drive is its own Worker at drive.zeiko.biz.id. /drive asks it for
  // its plans through this binding (src/drive.js); nothing else goes over it.
  "services": [{ "binding": "DRIVE", "service": "zeiko-production" }]
}
